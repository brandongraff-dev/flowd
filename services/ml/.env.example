# flowd ML service: copy to .env for local development. Production reads real environment variables.
ML_ENV=dev                         # dev | test | prod (prod requires ML_API_KEY and disables /docs)
# ML_API_KEY=change-me             # bearer token the flowd backend sends; unset = open (dev only)
ML_ADAPTERS=fake                   # fake: deterministic, zero GPU | real: Whisper, PySceneDetect, Claude VLM, SigLIP
# ML_FIXED_NOW=2026-10-03T14:00:00Z  # pin "now" to the demo world's clock
# ML_ALLOW_SCENARIO_URIS=true     # accept fake://<scenario> video URIs (dev); set false when deployed
# ML_MODEL_DIR=models              # <dir>/creative_scorer enables the learned scorer in shadow mode
# ML_VLM_MODEL=claude-sonnet-5-5
# ML_WHISPER_MODEL=large-v3
# ML_EMBEDDER=siglip               # siglip | clip
# ANTHROPIC_API_KEY=               # only for ML_ADAPTERS=real

# How flowd calls this service (the Supabase edge functions: settle-window, sync-views, housekeeping read these two names)
#   ML_BASE_URL=https://<your-modal-or-fly-host>      the URL of this service
#   ML_API_KEY=<the same value as above>              sent as "Authorization: Bearer <key>"
# supabase/functions/.env.example lists every other variable the backend needs.
