# flowd edge functions: copy to .env for `supabase functions serve --env-file .env`. Production secrets are set with
#   supabase secrets set --env-file supabase/functions/.env.production
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the Edge runtime: do not set them in production.
# Never commit a real .env (it is in .gitignore). Every variable and the function that reads it: docs/ARCHITECTURE.md, "Environment variables".

# ── core ─────────────────────────────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=            # from `supabase status`; local only
CRON_SECRET=local-dev-cron-secret     # same value as the Vault secret `cron_secret` (migration 0006); 32+ random bytes in production

# Adapters: mock (default, nothing leaves the process) or live. FLOWD_ADAPTER_<NAME> overrides one: PLATFORM, PAYMENTS, ADS, ML, PUSH.
FLOWD_ADAPTERS=mock
# FLOWD_ADAPTER_PAYMENTS=live
# FLOWD_FIXED_NOW=2026-10-03T14:00:00Z    # pin the clock to the demo world; NEVER set in production

# ── encryption (social tokens, webhook secrets, ad-account tokens) ───────────────────────────────────────────
# JSON key ring { "<version>": "<base64 of 32 random bytes>" }. Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate: add version 2, set TOKEN_ENCRYPTION_ACTIVE_VERSION=2, deploy; housekeeping re-seals old rows; remove version 1 when none are left.
TOKEN_ENCRYPTION_KEYS={"1":"REPLACE_WITH_BASE64_32_BYTES"}
TOKEN_ENCRYPTION_ACTIVE_VERSION=1

# ── Stripe (live payments) ───────────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                    # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=                # whsec_... of the platform endpoint .../functions/v1/webhook-stripe
STRIPE_CONNECT_WEBHOOK_SECRET=        # whsec_... of the Connect endpoint (same URL, "events on connected accounts")

# ── RevenueCat ───────────────────────────────────────────────────────────────────────────────────────────────
# Project-wide fallback secret for the demo; each app's own secret is sealed in encrypted_secrets (purpose revenuecat_webhook).
REVENUECAT_WEBHOOK_SECRET=

# ── ML service (services/ml) ─────────────────────────────────────────────────────────────────────────────────
ML_BASE_URL=http://127.0.0.1:8080
ML_API_KEY=

# ── social platforms (live view sync) ────────────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── push (APNs token auth) ───────────────────────────────────────────────────────────────────────────────────
APNS_KEY_P8=                          # the .p8 contents, with \n for newlines
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.flowd.creator
APNS_SANDBOX=false

# ── outbound webhooks ────────────────────────────────────────────────────────────────────────────────────────
WEBHOOK_USER_AGENT=flowd-webhooks/1.0 (+https://joinflowd.io/docs/webhooks)
