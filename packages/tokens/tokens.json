        "sheen": { "angle": 135, "from": "rgba(255, 255, 255, 0.07)", "to": "rgba(255, 255, 255, 0.01)" },
        "rim": { "from": "rgba(255, 255, 255, 0.34)", "mid": "rgba(255, 255, 255, 0.10)", "to": "rgba(255, 255, 255, 0.05)", "width": 1 },
        "highlight": "rgba(255, 255, 255, 0.20)", "lowlight": "rgba(0, 0, 0, 0.35)", "edge": "rgba(2, 5, 20, 0.55)",
        "scrim": "{color.semantic.dark.scrim}",
