  "glass": {
    "note": "Glass is a material (CONVENTIONS.md section 2). L1 is quiet glass (a content surface); L2 and L3 are real glass and may float over L1 but never over each other. Never more than two layers in a stack; inside glass use fills (surface-field, surface-active), not more glass. The fill carries the legibility scrim: raise fill alpha, never lower blur, to gain contrast.",
    "layers": {
      "L1": { "role": "Content surfaces: cards, panels, list groups. Quiet glass: low blur, high fill (Material on iOS).", "radius": "2xl", "padding": 20 },
      "L2": { "role": "Floating controls: nav, tab bar, toolbars, pills, FABs. Real glass (glassEffect on iOS 26).", "radius": "pill", "padding": 12 },
      "L3": { "role": "Modals and sheets (thick) with scrim behind. Real glass.", "radius": "3xl", "padding": 24 }
    },
    "dark": {
      "L1": {
        "blur": 16, "saturate": 1.4,
        "fill": "{color.semantic.dark.surface-glass-1}", "fillOverMedia": "rgba(8, 14, 36, 0.78)",
