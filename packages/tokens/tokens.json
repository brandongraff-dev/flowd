        "rim": { "from": "rgba(255, 255, 255, 0.46)", "mid": "rgba(255, 255, 255, 0.12)", "to": "rgba(255, 255, 255, 0.07)", "width": 1 },
        "highlight": "rgba(255, 255, 255, 0.22)", "lowlight": "rgba(0, 0, 0, 0.28)", "edge": "rgba(2, 5, 20, 0.45)",
        "elevation": 2, "solid": "{color.primitive.abyss.900}"
      },
