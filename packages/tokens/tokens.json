        "sheen": { "angle": 135, "from": "rgba(255, 255, 255, 0.12)", "to": "rgba(255, 255, 255, 0.02)" },
        "rim": { "from": "rgba(255, 255, 255, 0.60)", "mid": "rgba(255, 255, 255, 0.16)", "to": "rgba(255, 255, 255, 0.10)", "width": 1 },
        "highlight": "rgba(255, 255, 255, 0.34)", "lowlight": "rgba(0, 0, 0, 0.30)", "edge": "rgba(2, 5, 20, 0.50)",
        "elevation": 3, "solid": "{color.primitive.abyss.850}"
