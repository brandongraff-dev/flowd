      "note": "Clear glass: only over media-rich content, under large bold content, never for body text. Needs the dim layer (Apple HIG: about 35% dark).",
      "blur": 10, "saturate": 1.5, "tint": "rgba(255, 255, 255, 0.03)", "dim": "rgba(0, 0, 0, 0.35)",
      "rim": { "from": "rgba(255, 255, 255, 0.55)", "mid": "rgba(255, 255, 255, 0.14)", "to": "rgba(255, 255, 255, 0.10)", "width": 1 }
    },
    "refraction": {
      "note": "Optional progressive enhancement for hero/primary elements only (Chromium). SVG feTurbulence + feDisplacementMap on the backdrop; fall back to plain blur everywhere else.",
      "baseFrequency": 0.012, "octaves": 2, "displacementScale": 14, "edgeBlur": 0.6
    },
    "ios": {
      "note": "L1 is quiet glass on every OS: a Material + tint + rim stroke, never glassEffect (HIG: no glass on content). L2 and L3 use glassEffect on iOS 26+ through the DesignSystem wrappers, and Material + tint + rim stroke on iOS 17-25.",
      "L1": { "usesGlassEffect": false, "variant": "quiet", "interactive": false, "fallbackMaterial": "thinMaterial", "fallbackTintOpacityDark": 0.40, "fallbackTintOpacityLight": 0.30, "strokeOpacityDark": 0.22, "strokeOpacityLight": 0.60 },
      "L2": { "usesGlassEffect": true, "variant": "regular", "interactive": true, "fallbackMaterial": "ultraThinMaterial", "fallbackTintOpacityDark": 0.34, "fallbackTintOpacityLight": 0.28, "strokeOpacityDark": 0.32, "strokeOpacityLight": 0.80 },
      "L3": { "usesGlassEffect": true, "variant": "regular", "interactive": false, "fallbackMaterial": "thickMaterial", "fallbackTintOpacityDark": 0.55, "fallbackTintOpacityLight": 0.50, "strokeOpacityDark": 0.20, "strokeOpacityLight": 0.60 }
    }
  },

