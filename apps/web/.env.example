# flowd web: copy to .env.local. Everything is optional: the app runs fully
# offline against the persisted demo store seeded from fixtures.

# Public origin used for metadata, OG tags and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the typed client sends requests. The default is the in-app mock backend
# (src/app/api/v1), which implements packages/contract/openapi.yaml.
NEXT_PUBLIC_API_BASE=/api/v1

# Shows the subtle "Demo data" affordance where the data is seeded, not live.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: ML service (services/ml, FastAPI). Falls back to the in-app checklist scorers.
ML_SERVICE_URL=http://localhost:8000

# Optional: lets Flo (the in-app copilot) answer with a real model. Without it Flo
# uses deterministic, scripted responses. Server-side only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Flo, the copilot (see src/lib/SUPPORT.md section 2). All optional.
# "local" runs the deterministic mock in the browser; "remote" calls /api/v1/flo/chat, which can use Claude.
NEXT_PUBLIC_FLO_MODE=local
# Server side: auto (Claude when a key is set, otherwise the mock), mock, or claude.
FLO_PROVIDER=auto
FLO_MODEL=claude-sonnet-5-5
FLO_MAX_TOKENS=4000
# Retry a policy decline on the model Anthropic names (server-side fallbacks).
FLO_REFUSAL_FALLBACK=true
# Requests per minute per client on the Flo route (it fronts a paid API).
FLO_RATE_LIMIT_PER_MIN=20

# Analytics: "none" (default, nothing leaves the browser) or "posthog" (needs a PostHog client on the page).
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Force search indexing on or off. Unset: indexing is on only for the canonical https://joinflowd.io domain.
NEXT_PUBLIC_ALLOW_INDEXING=
